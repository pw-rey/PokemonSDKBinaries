         for (unsigned int i = 0; i < m_formatCtx->nb_streams; i++)
         {
             AVStream* & ffstream = m_formatCtx->streams[i];
+
+            // Containers may carry cover artwork as an attached video stream
+            // (commonly PNG or JPEG).  It is metadata, not movie content, and
+            // must not be passed to VideoStream as though it were a frame
+            // stream.
+            if (ffstream->disposition & AV_DISPOSITION_ATTACHED_PIC)
+            {
+                m_ignoredStreams[ffstream->index] = Stream::AVStreamDescription(ffstream);
+                sfeLogDebug(m_ignoredStreams[ffstream->index] + " attached picture ignored");
+                continue;
+            }
             
             try
