 #include "rb_common.h"
-#include "Texture_Bitmap.h"
+#include <Texture_Bitmap.h>
 
 VALUE rb_cMovie = Qnil;
 VALUE rb_cBitmap = Qnil;
 VALUE rb_eRGSSError = Qnil;
 
+// LiteRGSS now wraps Bitmap/Texture instances with Ruby TypedData.  The
+// descriptor is owned by LiteRGSS, so obtain it from an actual Bitmap object:
+// constructing an equivalent descriptor in this extension would have a
+// different address and Ruby would reject valid Texture subclasses.
+static const rb_data_type_t* bitmap_data_type = nullptr;
+
+static sf::Texture& bitmap_texture(VALUE bitmap) {
+  auto* wrapper = static_cast<TextureElement*>(rb_check_typeddata(bitmap, bitmap_data_type));
+  if (wrapper == nullptr || wrapper->instance() == nullptr) {
+    rb_raise(rb_eRGSSError, "Disposed or uninitialized Texture.");
+  }
+  return wrapper->instance()->raw();
+}
+
 void rb_Movie_Free(void* data)
 {
   sfe::Movie* pdata = reinterpret_cast<sfe::Movie*>(data);
