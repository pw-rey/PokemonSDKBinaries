-  auto image = data->getCurrentImage();
-	VALUE bmp = rb_obj_alloc(rb_cBitmap);
-	sf::Texture& bmpTexture = rb::Get<TextureElement>(bmp)->raw();
-	bmpTexture = image;
-	return bmp;
+  const auto& image = data->getCurrentImage();
+  const auto size = image.getSize();
+  VALUE args[] = {UINT2NUM(size.x), UINT2NUM(size.y)};
+  VALUE bmp = rb_class_new_instance(2, args, rb_cBitmap);
+  bitmap_texture(bmp) = image;
